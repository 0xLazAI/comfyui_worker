# comfyui-worker (blender pace-review). Only the vars below need setting; everything
# else has a sensible code default (see src/infra/constants.ts).
#
# Agent (codex/claude) model + reasoning settings are NOT env vars — they live in
# src/blender/config.ts. The only credential that stays in the environment is the
# optional codex/anthropic API key (OPENAI_API_KEY); locally the codex CLI uses its
# own authenticated app session, so no key is required.

# ── Worker identity / network ──
COMFYUI_WORKER_NAME=comfyui-render-worker
COMFYUI_WORKER_BASE_URL=http://127.0.0.1:8091   # public URL this worker registers under
COMFYUI_WORKER_TOKEN=replace-me
# NODE_ENV=production

# ── Pai Platform API (set to run in platform mode; leave unset for standalone) ──
PAI_PLATFORM_API_BASE=https://pai-api-test.lazai.io
PAI_PLATFORM_API_KEY=replace-with-platform-api-key

# ── PAI Platform GraphQL ──
# Endpoint used by the GraphQL codegen scripts (npm run graphql:schema /
# graphql:codegen) and the runtime PAI Platform SDK. See docs/graphql-sdk.md.
PAI_PLATFORM_GRAPH=https://pai-api-test.lazai.io/api/graphql/

# ── Database (Postgres) ──
DATABASE_URL=postgresql://user:password@host:25060/comfy-ui-worker?sslmode=require
DATABASE_SSL=true
# Set false when multiple workers share one DB: concurrent startups with sync=true
# race to seed task_type_definitions and create duplicate rows that then break the
# unique index on the next boot.
COMFYUI_WORKER_DATABASE_SYNC=false

# ── Queue (Redis) ──
REDIS_URL=redis://127.0.0.1:6379
QUEUE_KEY_PREFIX=comfyui-worker
COMFYUI_WORKER_QUEUE_NAME=comfyui-worker

# ── Task execution (blender jobs are slow — raise the short defaults) ──
COMFYUI_WORKER_MAX_ATTEMPTS=1
COMFYUI_WORKER_TIMEOUT_SECONDS=1800
COMFYUI_WORKER_RETRY_AFTER_SECONDS=2100

# ── Blender runner (PAILang, GPU) ──
STEPHEN_RENDER_BASE_URL=https://your-pailang-host:8911   # online blender runner (gpu), HTTPS
# Runner TLS: if the runner presents a private/self-signed cert, trust it securely by
# pointing this at the CA bundle (PEM). Preferred over disabling verification.
# PAI_BLENDER_RUNNER_CA=/etc/pai/runner-ca.pem
# Dev/self-signed escape hatch — disables TLS verification for the runner connection
# ONLY (scoped, not a process-wide NODE_TLS bypass). Do not use in production.
# PAI_BLENDER_RUNNER_INSECURE_TLS=true

# ── Asset storage (S3) — legacy object-storage fallback, used only when PLATFORM_API is disabled ──
PAI_ASSET_ENDPOINT=
PAI_ASSET_BUCKET=pai-assets
PAI_ASSET_REGION=us-east-1
PAI_ASSET_ACCESS_KEY_ID=example-access-key
PAI_ASSET_SECRET_ACCESS_KEY=example-secret-key

# ── Optional overrides (defaults shown; uncomment only to change) ──
# Local-dev storage (defaults are the production paths /data, /var):
# PAI_PROJECTS_MOUNT_ROOT=.local/pai-projects
# COMFYUI_WORKER_REGISTRY_ROOT=.local/pai-projects/.pai-workers
# PAI_CACHE_DIR=.local/cache
# PAI_TMP_DIR=.local/tmp
# PAI_LOG_DIR=.local/logs
# Optional codex/anthropic API key (otherwise the codex CLI app session is used):
# OPENAI_API_KEY=
# Codex CLI binary path override (default in src/blender/config.ts):
# CODEX_CLI_PATH=/Applications/Codex.app/Contents/Resources/codex
# Advanced blender timeouts (defaults: job 600s, poll 3s / 900s):
# PAI_BLENDER_JOB_TIMEOUT_SECONDS=600
# PAI_BLENDER_POLL_INTERVAL_SECONDS=3
# PAI_BLENDER_POLL_TIMEOUT_SECONDS=900
