NODE_ENV=production

PAI_PLATFORM_API_BASE=https://pai-api-test.lazai.io
PAI_PLATFORM_API_KEY=replace-with-platform-api-key

PAI_WORKER_NAME=comfyui-render-worker
PAI_WORKER_HOST=0.0.0.0
PAI_WORKER_PORT=8080
PAI_WORKER_BASE_URL=http://127.0.0.1:8080
PAI_WORKER_TOKEN=demo-worker-token
PAI_WORKER_NODE_TYPE=comfyui
PAI_WORKER_VERSION=1.0.0
PAI_CONTRACT_VERSION=2026-06-01
PAI_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
PAI_TASK_CONCURRENCY=1
PAI_TASK_TIMEOUT_SECONDS=300

# Legacy shared-fs settings remain for compatibility mode only.
PAI_PROJECTS_MOUNT_ROOT=/data/pai-projects
PAI_PROJECTS_MOUNT_MODE=rw
PAI_PROJECTS_EXPECT_SHARED_FS=false
COMFYUI_WORKER_PROJECTS_ROOT=/data/pai-projects
COMFYUI_WORKER_REGISTRY_ROOT=/data/pai-projects/.pai-workers

PAI_CACHE_DIR=/var/cache/pai
PAI_TMP_DIR=/var/tmp/pai
PAI_LOG_DIR=/var/log/pai

COMFYUI_WORKER_QUEUE_NAME=demo-worker
COMFYUI_WORKER_JOB_NAME=render-panel.execute
COMFYUI_WORKER_MAX_ATTEMPTS=3
COMFYUI_WORKER_BACKOFF_SECONDS=15,60,180
COMFYUI_WORKER_RETRY_AFTER_SECONDS=900
COMFYUI_WORKER_PROVIDER_POLL_INTERVAL_SECONDS=3

STEPHEN_RENDER_BASE_URL=http://34.215.238.232:8911

# LoRA training runner. The worker only submits/polls; the GPU runner pulls S3
# datasets, trains, and returns local LoRA paths.
LORA_TRAINER_SSH_HOST=ubuntu@152.32.185.32
LORA_TRAINER_SSH_PORT=8004
LORA_TRAINER_COMMAND=/home/ubuntu/sd/lora-trainer/bin/train_style_lora
LORA_TRAINER_SYNC_ENABLED=true
LORA_TRAINER_LOCAL_SCRIPT=scripts/train_style_lora_runner.py
LORA_TRAINER_REMOTE_SCRIPT=/home/ubuntu/sd/lora-trainer/bin/train_style_lora.py
LORA_TRAINER_REMOTE_ENV_FILE=/home/ubuntu/sd/lora-trainer/.env
LORA_TRAINER_SYNC_LOCK_FILE=/home/ubuntu/sd/lora-trainer/.sync.lock
LORA_TRAINER_POLL_INTERVAL_SECONDS=30

# Legacy object-storage fallback, used only when PLATFORM_API is disabled.
PAI_ASSET_ENDPOINT=
PAI_ASSET_BUCKET=pai-assets
PAI_ASSET_REGION=us-east-1
PAI_ASSET_ACCESS_KEY_ID=example-access-key
PAI_ASSET_SECRET_ACCESS_KEY=example-secret-key
PAI_ASSET_PREFIX_TEMPLATE={project_id}/
PAI_ASSET_URL_EXPIRES_SECONDS=432000

DATABASE_URL=postgresql://user:password@host:25060/comfy-ui-worker?sslmode=require
COMFYUI_WORKER_DATABASE_SYNC=true
COMFYUI_WORKER_DATABASE_LOG_SQL=false
DATABASE_SSL=true
DATABASE_CA=

REDIS_URL=redis://127.0.0.1:6379
QUEUE_KEY_PREFIX=
