COMFYUI_WORKER_NAME=demo-worker
COMFYUI_WORKER_HOST=0.0.0.0
COMFYUI_WORKER_PORT=8091
COMFYUI_WORKER_BASE_URL=http://127.0.0.1:8091
COMFYUI_WORKER_TOKEN=demo-worker-token
COMFYUI_WORKER_NODE_TYPE=comfyui
COMFYUI_WORKER_VERSION=1.0.0
COMFYUI_WORKER_CONTRACT_VERSION=2026-06-01
PAI_PROJECTS_MOUNT_ROOT=/data/pai-projects
PAI_PROJECTS_MOUNT_MODE=rw
PAI_PROJECTS_EXPECT_SHARED_FS=true
COMFYUI_WORKER_PROJECTS_ROOT=/data/pai-projects
COMFYUI_WORKER_REGISTRY_ROOT=/data/pai-projects/.pai-workers
COMFYUI_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
PAI_CACHE_DIR=/var/cache/pai
PAI_TMP_DIR=/var/tmp/pai
PAI_LOG_DIR=/var/log/pai
COMFYUI_WORKER_QUEUE_NAME=demo-worker
COMFYUI_WORKER_JOB_NAME=render-panel.execute
COMFYUI_WORKER_MAX_ATTEMPTS=3
COMFYUI_WORKER_BACKOFF_SECONDS=15,60,180
COMFYUI_WORKER_TIMEOUT_SECONDS=300
COMFYUI_WORKER_RETRY_AFTER_SECONDS=900
COMFYUI_WORKER_PROVIDER_POLL_INTERVAL_SECONDS=3
STEPHEN_RENDER_BASE_URL=http://34.215.238.232:8911
# PAILang blender runner. Online defaults to STEPHEN_RENDER_BASE_URL; local is
# the pai-blender-worker console mock (runner_target=local).
PAI_BLENDER_ONLINE_BASE_URL=
PAI_BLENDER_LOCAL_BASE_URL=http://127.0.0.1:3002
# Per-job Blender wall-clock timeout sent to the runner (PAILang caps at 600s).
PAI_BLENDER_JOB_TIMEOUT_SECONDS=600
# Polling cadence/timeout against the PAILang job status endpoint.
BLENDER_API_POLL_INTERVAL_SECONDS=3
BLENDER_API_TIMEOUT_SECONDS=900
BLENDER_AGENT_INSTRUCTIONS_PATH=agent.md
OPENAI_CODEX_MODEL=gpt-5.5
OPENAI_CODEX_REASONING_EFFORT=high
# Hard wall-clock bound (ms) for a single codex turn. On overrun the turn is aborted so the
# spawned `codex exec` child is terminated instead of leaking and wedging the Codex app-server.
# Keep this below the blender task timeout (execution.timeout_seconds). Default: 900000 (15m).
OPENAI_CODEX_TURN_TIMEOUT_MS=900000
# Shorter wall-clock bound (ms) for preview-review Codex turns. Default: 120000 (2m).
BLENDER_PREVIEW_REVIEW_TIMEOUT_MS=120000
PAI_ASSET_ENDPOINT=
PAI_ASSET_BUCKET=pai-assets
PAI_ASSET_REGION=us-east-1
PAI_ASSET_ACCESS_KEY_ID=example-access-key
PAI_ASSET_SECRET_ACCESS_KEY=example-secret-key
PAI_ASSET_PREFIX_TEMPLATE={project_id}/
PAI_ASSET_URL_EXPIRES_SECONDS=432000
DATABASE_URL=postgresql://user:password@host:25060/comfy-ui-worker?sslmode=require
# WARNING: set to false when multiple workers share the same DB (e.g. team members running locally
# against a shared cloud DB). Concurrent startups with sync=true trigger TOCTOU races that create
# duplicate rows, which then break the unique index on task_type_definitions at next startup.
COMFYUI_WORKER_DATABASE_SYNC=false
COMFYUI_WORKER_DATABASE_LOG_SQL=false
DATABASE_SSL=true
DATABASE_CA=
REDIS_URL=redis://127.0.0.1:6379
QUEUE_KEY_PREFIX=
